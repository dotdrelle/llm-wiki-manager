# .env — wiki-manager local configuration
#
# Copy this file to .env and fill in your values.
# This file is loaded automatically by wiki-workspace for workspace compose
# and agents compose commands.
#
# NEVER commit .env — it is gitignored.

# ── Paths ──────────────────────────────────────────────────────────────────────

# Root directory that contains all workspace folders.
# Required when using: wiki-workspace agents up/down/logs
WORKSPACES_ROOT=/path/to/workspaces

# Directory for agent persistent state (cme config, document queues).
# Defaults to .agents-data/ next to wiki-workspace.
# AGENTS_DATA_DIR=/path/to/.agents-data

# ── VPN / outbound HTTP proxy (optional) ──────────────────────────────────────
#
# Node fetch does not use HTTP_PROXY / HTTPS_PROXY unless environment proxy
# support is enabled. This matters for the manager runtime's own LLM calls
# (including runtime.delegate objective resolution) behind a corporate VPN.
# Keep these lines commented when no proxy is required.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.example:11011
# HTTP_PROXY=http://proxy.example:11011
# Always bypass the proxy for the local runtime, local MCPs, and Docker host.
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
# Optional organization-approved HTTPS endpoint for the ShellUI startup probe.
# WIKI_MANAGER_CONNECTIVITY_URL=https://registry.npmjs.org/-/ping

# ── Agent auth tokens ──────────────────────────────────────────────────────────
#
# Each agent has its own bearer token. Set the matching Authorization header
# in mcp.endpoints.json so Donna can call the agent:
#
#   "cme":       { "headers": { "Authorization": "Bearer <CME_MCP_AUTH_TOKEN>" } }
#   "documents": { "headers": { "Authorization": "Bearer <DOCUMENTS_MCP_AUTH_TOKEN>" } }
#
# Leave empty to disable authentication on that agent (not recommended in production).
CME_MCP_AUTH_TOKEN=
DOCUMENTS_MCP_AUTH_TOKEN=

# ── Agent ports (optional, change only if defaults conflict) ───────────────────

# CME_MCP_PORT=3336
# DOCUMENTS_MCP_PORT=3337
# CONNECTORS_MCP_PORT=3338

# ── SaaS connectors (optional) ────────────────────────────────────────────────
#
# Enable the opt-in agent-connectors service:
CONNECTORS_ENABLED=false
CONNECTORS_MCP_AUTH_TOKEN=

# Agentic runtime gateway (Deep Agents) — enabled by default, started by
# `agents up`. The manager never starts it, only discovers it via
# agent-runtimes.json; set GATEWAY_ENABLED=false to opt out.
GATEWAY_ENABLED=true
# GATEWAY_PORT=7789
# Generated by `agents up` if empty, like the other agent tokens; the manager
# sends it as the Bearer header on every gateway call.
GATEWAY_AUTH_TOKEN=
#
# The wikiLLM Google OAuth application is baked into the agent-connectors image
# at build time, from agent-external/agent-connectors/.env.build.local. Neither
# value is a security boundary (public Desktop-type client); baking them is what
# makes the connector work out of the box.
#
# Set either key below to use YOUR OWN Google application instead — it overrides
# the baked default at runtime, no rebuild needed. LEAVE THEM COMMENTED to keep
# the baked one: an empty value here is forwarded as an empty value and disables
# the client entirely.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# The callback URL is generated automatically
# by `wiki-workspace agents up` when empty. Register the resulting exact URL in
# Google Cloud Console. Override it only for a remote/public HTTPS deployment.
# GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:${CONNECTORS_MCP_PORT}/oauth/google/callback
#
# Generated automatically when missing. Keep the two secrets distinct.
# OAUTH_STATE_SECRET=
# OAUTH_START_TOKEN=
# OAUTH_STATE_TTL_SECONDS=600
#
# Collection concurrency advertised to Donna:
# CONNECTORS_RECOMMENDED_CONCURRENCY=2
# CONNECTORS_MAX_CONCURRENCY=4

# ── Documents LLM OCR / Mermaid (optional) ─────────────────────────────────────

# All image OCR is delegated to an OpenAI-compatible vision LLM, and it is OFF
# until you configure it here. The compose file passes empty defaults on
# purpose, so no deployment ever calls a provider it was not pointed at.
#
# Uncomment the three keys together — the agent disables LLM OCR when any of
# the endpoint, the model or the key is missing.
#
# DOCUMENT_LLM_BASE_URL=
# DOCUMENT_LLM_MODEL=
# DOCUMENT_LLM_API_KEY=
# DOCUMENT_LLM_TIMEOUT_SECONDS=120

# ── Optional external MCP providers ────────────────────────────────────────────
# Doctrine: every variable an external MCP endpoint needs (API key, token…)
# lives HERE and is referenced from mcp.endpoints.json as ${VAR_NAME}.
# Add your own entries when you declare additional endpoints.

# ── Orchestration (optional) ───────────────────────────────────────────────────
# The runtime runs on the host while `llm-wiki serve` runs in Docker and
# reaches it through host.docker.internal. Listen on all host interfaces so
# the container can connect; exposed runtimes are protected by the generated
# WIKI_MANAGER_RUNTIME_TOKEN.
#
# WIKI_MANAGER_RUNTIME_PORT=7788
# Set to 0 to skip pulling and renewing already-running containers at startup.
# WIKI_MANAGER_AUTO_UPDATE=1
#
# Active by default, and required: `serve` runs in Docker and reaches the host
# runtime through host.docker.internal. A runtime bound to 127.0.0.1 only
# accepts connections from the host itself, so the container gets ECONNREFUSED
# and the workspace UI shows no runtime at all. Binding all interfaces always
# generates WIKI_MANAGER_RUNTIME_TOKEN (0600 in .wiki/runtime/runtime.token),
# so the exposed port is never unauthenticated.
# Set to 127.0.0.1 only when nothing runs in a container.
WIKI_MANAGER_RUNTIME_HOST=0.0.0.0


# ── Parallelism & throughput ───────────────────────────────────────────────────
# Effective concurrency = MIN(agent recommendedConcurrency, agent maxConcurrency,
# this ceiling, per-task limits). So the PRIMARY levers live on the production
# agent (PRODUCTION_RECOMMENDED_CONCURRENCY / PRODUCTION_MAX_CONCURRENCY); this
# manager variable can only LOWER the result, never raise it. Full explanation
# and low/high profiles in docs/configuration.md § "Parallelism & throughput".
#
# Manager ceiling — leave unset to let the agent decide. Set to constrain:
# WIKI_MANAGER_CAPABILITY_CONCURRENCY=4
#
# Production agent capacity (passed through by docker-compose). Intermediate
# defaults are 4/8 (effective ≈ 4 parallel). Profiles:
#   low   → PRODUCTION_RECOMMENDED_CONCURRENCY=2  PRODUCTION_MAX_CONCURRENCY=4
#   high  → PRODUCTION_RECOMMENDED_CONCURRENCY=8  PRODUCTION_MAX_CONCURRENCY=16
# The wiki LLM backend must accept this many concurrent requests, and
# ingest_apply stays serialized regardless (global workspace-write lock).
# PRODUCTION_RECOMMENDED_CONCURRENCY=4
# PRODUCTION_MAX_CONCURRENCY=8

# ── MCP retry policy (optional) ────────────────────────────────────────────────

# Tool calls are retried on transient HTTP/MCP errors before the run fails.
# WIKI_MANAGER_MCP_RETRY_MAX_ATTEMPTS=2
# WIKI_MANAGER_MCP_RETRY_BACKOFF_MS=500
# Outbound MCP control budget, separate from .wikirc LLM requestsPerMinute.
# Default: 45 RPM (headroom for MCP servers limited to 50 RPM).
# WIKI_MANAGER_MCP_REQUESTS_PER_MINUTE=45

# ── Runtime evaluator (optional) ───────────────────────────────────────────────

# After a clean agentic runtime run, a second LLM pass checks whether the original
# task was accomplished. Set to 0/false/off/no to disable globally.
# WIKI_MANAGER_EVALUATOR=1

# If evaluator rejects a run or an activity ends in error, the runtime can ask
# the LLM for a partial recovery plan and retry remaining work.
# WIKI_MANAGER_REPLANNER_MAX_REPLANS=2

# Runtime approvals can pause runs or protected tools until /approve is called.
# WIKI_MANAGER_APPROVAL_TIMEOUT_MS=600000
# WIKI_MANAGER_REQUIRE_APPROVAL_TOOLS=production.production_start_job
