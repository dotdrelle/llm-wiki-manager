#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_TARGET="$(readlink "$SCRIPT_SOURCE")"
  if [[ "$SCRIPT_TARGET" = /* ]]; then
    SCRIPT_SOURCE="$SCRIPT_TARGET"
  else
    SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_TARGET"
  fi
done
ROOT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
DEFAULT_MANAGER_DIR="$PWD"
WORKSPACES_DIR="${WIKI_WORKSPACES_DIR:-$DEFAULT_MANAGER_DIR/workspaces}"
MANAGER_ENV_FILE="${WIKI_MANAGER_ENV_FILE:-$DEFAULT_MANAGER_DIR/.env}"
MANAGER_ENDPOINTS_FILE="${WIKI_MANAGER_ENDPOINTS_FILE:-$DEFAULT_MANAGER_DIR/mcp.endpoints.json}"
MANAGER_STATE_DIR="$(cd "$(dirname "$MANAGER_ENV_FILE")" && pwd)"
MANAGER_COMPOSE_DIR="$MANAGER_STATE_DIR/.wiki/compose"
MANAGER_RUNTIME_DIR="$MANAGER_STATE_DIR/.wiki/runtime"
LEGACY_MANAGER_RUNTIME_DIR="$MANAGER_STATE_DIR/.wiki-manager"
if [[ ! -e "$MANAGER_RUNTIME_DIR" && -d "$LEGACY_MANAGER_RUNTIME_DIR" ]]; then
  mkdir -p "$MANAGER_STATE_DIR/.wiki"
  mv "$LEGACY_MANAGER_RUNTIME_DIR" "$MANAGER_RUNTIME_DIR"
fi
CACERT_PATH="${WIKI_MANAGER_CACERT_PATH:-}"

normalize_path() {
  local value="$1"
  if command -v wslpath >/dev/null 2>&1 && [[ "$value" =~ ^[A-Za-z]:[\\/] ]]; then
    wslpath -u "$value"
    return
  fi
  printf '%s\n' "$value"
}

absolute_path() {
  local value="$1"
  local base="${2:-$ROOT_DIR}"
  value="$(normalize_path "$value")"
  if [[ "$value" = /* ]]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$base/$value"
  fi
}

parse_global_options() {
  local parsed=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cacert)
        [[ $# -ge 2 ]] || { printf 'Error: --cacert requires a file path\n' >&2; exit 2; }
        CACERT_PATH="$2"
        shift 2
        ;;
      *)
        parsed+=("$1")
        shift
        ;;
    esac
  done
  if [[ -n "$CACERT_PATH" ]]; then
    CACERT_PATH="$(absolute_path "$CACERT_PATH" "$PWD")"
    [[ -f "$CACERT_PATH" ]] || { printf 'Error: --cacert file not found: %s\n' "$CACERT_PATH" >&2; exit 2; }
    export WIKI_MANAGER_CACERT_PATH="$CACERT_PATH"
    export NODE_EXTRA_CA_CERTS="$CACERT_PATH"
    export SSL_CERT_FILE="$CACERT_PATH"
    export REQUESTS_CA_BUNDLE="$CACERT_PATH"
    export CURL_CA_BUNDLE="$CACERT_PATH"
  fi
  # `${arr[@]}` on an EMPTY array is an unbound-variable error under `set -u`
  # in bash <= 4.3 — which includes the /bin/bash 3.2 macOS still ships. Every
  # optional array in this script therefore goes through the `${arr[@]+…}`
  # guard (see compose_env_args, override_args, only_services…); these two were
  # missed, so any invocation without a global option died on this line before
  # reaching its subcommand.
  set -- ${parsed[@]+"${parsed[@]}"}
  PARSED_ARGS=("$@")
}

PARSED_ARGS=()
parse_global_options "$@"
set -- ${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}

usage() {
  cat <<'EOF'
Usage:
  wiki-workspace [--cacert <path>] <command> ...
  wiki-workspace config <workspace> [path]
  wiki-workspace up <workspace>
  wiki-workspace refresh
  wiki-workspace wiki <workspace> <command> [args...]
  wiki-workspace list

Commands:
  config <workspace> [path]         Create workspace folder, auto-select ports, run wiki init
  up <workspace> [--open]           Start workspace stack: wiki + production
  start [--open]                    Start everything: agent-runtime, agents and every
                                    configured workspace (--open opens the first chat)
  list                              List configured workspaces
  refresh                           Stop runtime/stacks and remove their Compose images

  agents up [--pull]                Start all external agents (cme, documents)
  agents down                       Stop all external agents
  agents logs [args...]             Follow external agent logs
  agents pull                       Pull latest external agent images
  agents refresh                    Update only external agents currently running
  agents status                     Check reachability of configured MCP endpoints

  runtime up                        Start the single host agent-runtime on Node.js 22
  runtime down                      Stop the host agent-runtime
  runtime status                    Check host agent-runtime health
  runtime logs [args...]            Show host agent-runtime logs

  wiki <workspace> init             Initialize the workspace with wiki init
  wiki <workspace> up               Start llm-wiki serve + mcp-http + production-mcp
  wiki <workspace> down             Stop all services for this workspace
  wiki <workspace> logs [args...]   Follow workspace service logs (tail 100 by default)
  wiki <workspace> serve [--open]   Start the web UI in foreground (--open launches browser)
  wiki <workspace> reset [--dry-run] [--yes]
                                    Empty the workspace, keeping .wikirc*, templates/ and
                                    build-context/. Requires the services to be stopped.
  wiki <workspace> doctor           Run wiki doctor
  wiki <workspace> ingest           Run wiki ingest
  wiki <workspace> build            Run wiki build
  wiki <workspace> export           Run wiki export
  wiki <workspace> run <args...>    Run arbitrary wiki CLI args (see below)

wiki CLI commands reachable through `wiki <workspace> run`:
  history [--file <path>] [--limit <n>] [--json]
                                    List workspace history commits (Git, workspace-local)
  restore --run <sha> [--dry-run]   Revert every file changed by a run commit
  restore --file <path> --to <sha> [--dry-run]
                                    Restore one versioned file to a revision
  query "<question>"                Answer from the wiki and its cited source notes
  index                             Create or update the local vector index
  refresh                           Regenerate only the stale deliverables
  lint                              Static checks: dead links, orphans, stale deliverables
  add-skill <source>                Install a workspace method (directory, .zip, HTTPS .zip)
  config                            Show the effective .wikirc.yaml
  doctor, ingest, build, export     Also available directly: wiki <workspace> <command>

  History is versioned for wiki/, templates/, build-context/, deliverables/,
  raw/ingested/ and .wiki/build-state.json only. A restore adds a commit rather
  than rewriting history, and --dry-run previews it without writing.

Configuration:
  workspaces/<workspace>/.env
  Override directory: WIKI_WORKSPACES_DIR=/path/to/dir
  Runtime node: WIKI_MANAGER_NODE_BIN=/path/to/node
  Local CA: --cacert /absolute/path/to/ca.pem (Docker must be able to read this host path)

Compose overrides (under .wiki/compose, created once, never regenerated):
  .wiki/compose/docker-compose.override.yml         Workspace stack
  .wiki/compose/agents.docker-compose.override.yml  Agents stack
  Use them for proxy passthrough, extra mounts and optional agents.
  Never edit .wiki/runtime/*.compose.yml — that is generated state, rewritten
  on every compose command.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

workspace_env_file() {
  local workspace="$1"
  printf '%s/%s/.env\n' "$WORKSPACES_DIR" "$workspace"
}

need_workspace_env() {
  local workspace="$1"
  local file
  file="$(workspace_env_file "$workspace")"
  [[ -f "$file" ]] || die "missing workspace env: $file — run: wiki-workspace config $workspace"
}

env_value() {
  local file="$1"
  local key="$2"
  local default="${3-}"
  local line value
  [[ -f "$file" ]] || { printf '%s\n' "$default"; return 0; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" == "$key="* ]] || continue
    value="${line#*=}"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
      value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    printf '%s\n' "$value"
    return 0
  done < "$file"
  printf '%s\n' "$default"
}

generate_token() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
    return
  fi
  if [[ -r /dev/urandom ]]; then
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
    return
  fi
  die "cannot generate MCP auth token: openssl and /dev/urandom are unavailable"
}

# Matches the commented placeholders shipped in .env.example — `# KEY=`,
# `#KEY=`, `##  KEY=` — but never a prose comment that merely mentions the key.
commented_assignment() {
  local line="$1"
  local key="$2"
  [[ "$line" =~ ^[[:space:]]*#+[[:space:]]*"$key"= ]]
}

set_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp="${file}.tmp.$$"
  local wrote=0 line
  local has_active=0

  if [[ -f "$file" ]]; then
    # Most generated keys (OAUTH_STATE_SECRET, GOOGLE_OAUTH_CALLBACK_URL,
    # WIKI_MANAGER_RUNTIME_TOKEN…) ship as commented placeholders in
    # .env.example. Appending the real value at the end of the file left the
    # commented twin above it, so the .env read top-down still documented the
    # key as unset — operators re-generated tokens that already existed. Reuse
    # the placeholder's own line instead, keeping the value under the comment
    # block that explains it.
    #
    # An ACTIVE assignment always wins: it is the operator's own choice, and a
    # commented line further down must stay commented rather than become a
    # second, contradictory assignment.
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" == "$key="* ]]; then
        has_active=1
        break
      fi
    done < "$file"

    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      if [[ "$line" == "$key="* ]]; then
        printf '%s=%s\n' "$key" "$value"
        wrote=1
      elif [[ "$has_active" -eq 0 && "$wrote" -eq 0 ]] && commented_assignment "$line" "$key"; then
        printf '%s=%s\n' "$key" "$value"
        wrote=1
      else
        printf '%s\n' "$line"
      fi
    done < "$file" > "$tmp"
  else
    : > "$tmp"
  fi

  if [[ "$wrote" -eq 0 ]]; then
    if [[ -s "$tmp" ]]; then
      printf '\n' >> "$tmp"
    fi
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  mv "$tmp" "$file"
}

agents_compose() {
  local subcommand="$1"
  shift
  ensure_manager_endpoints_file
  ensure_compose_override 'agents.docker-compose.override.example.yml' 'agents.docker-compose.override.yml'
  local agents_compose_file="$ROOT_DIR/agents.docker-compose.yml"
  [[ -f "$agents_compose_file" ]] || die "agents compose file not found: $agents_compose_file"

  local agents_data_dir workspaces_root
  workspaces_root="$(absolute_path "$WORKSPACES_DIR" "$DEFAULT_MANAGER_DIR")"
  # Canonical .agents-data lives next to the workspaces (same rule as the
  # manager's resolveAgentsDataDir): the serve stack and the agents stack MUST
  # mount the same host directory or document conversions break.
  agents_data_dir="$(absolute_path "${AGENTS_DATA_DIR:-$workspaces_root/.agents-data}" "$DEFAULT_MANAGER_DIR")"

  local compose_env_args=()
  [[ -f "$MANAGER_ENV_FILE" ]] && compose_env_args+=(--env-file "$MANAGER_ENV_FILE")

  # Ce script ne construit aucune image. L'application OAuth Google est cuite
  # dans l'image publiée par build-and-push.sh ; pour en utiliser une autre,
  # l'opérateur pose GOOGLE_OAUTH_CLIENT_ID / _SECRET dans le .env du manager,
  # que Compose transmet au conteneur et qui l'emporte sur la valeur embarquée.

  _agents_dc() {
    local cacert_args=()
    local profile_args=()
    connectors_enabled && profile_args+=(--profile connectors)
    gateway_enabled && profile_args+=(--profile gateway)
    # The gateway mounts the MANAGER's agent-runtimes.json — absolute path:
    # compose resolves relative volume paths against the compose file's
    # directory (the installed package), never the operator's state dir.
    local agent_runtimes_file="$(dirname "$MANAGER_ENV_FILE")/agent-runtimes.json"
    WORKSPACES_ROOT="$workspaces_root" AGENTS_DATA_DIR="$agents_data_dir" AGENT_RUNTIMES_FILE="$agent_runtimes_file" \
      read_lines_into_array cacert_args cacert_compose_args "$agents_compose_file" "agents.cacert.compose.yml"
    # User-owned override: optional external agents, proxy passthrough and
    # any local fix live in a file the user maintains under .wiki/compose —
    # scaffolded once by ensure_compose_override, never overwritten afterwards.
    local override_args=()
    local user_override="$MANAGER_COMPOSE_DIR/agents.docker-compose.override.yml"
    [[ -f "$user_override" ]] && override_args+=(-f "$user_override")
    WORKSPACES_ROOT="$workspaces_root" AGENTS_DATA_DIR="$agents_data_dir" AGENT_RUNTIMES_FILE="$agent_runtimes_file" \
      COMPOSE_PROFILES= \
      docker compose --project-directory "$DEFAULT_MANAGER_DIR" \
        ${compose_env_args[@]+"${compose_env_args[@]}"} -f "$agents_compose_file" ${override_args[@]+"${override_args[@]}"} ${cacert_args[@]+"${cacert_args[@]}"} ${profile_args[@]+"${profile_args[@]}"} -p wiki-agents "$@"
  }

  case "$subcommand" in
    up)
      local do_pull=false
      if [[ "${1:-}" == "--pull" ]]; then
        do_pull=true
        shift
      fi
      # Services nommés : démarrer `connectors` seul une fois le profil actif,
      # sans relancer toute la pile. Sans argument, tout monte comme avant.
      local only_services=("$@")
      ensure_agent_tokens
      ensure_endpoints_file
      # The .env may have just been created above — recompute the env-file
      # flag so freshly generated tokens reach the containers on first run.
      compose_env_args=()
      [[ -f "$MANAGER_ENV_FILE" ]] && compose_env_args+=(--env-file "$MANAGER_ENV_FILE")
      mkdir -p "$agents_data_dir/cme" "$agents_data_dir/documents/input" "$agents_data_dir/documents/output" "$agents_data_dir/documents/uploads"
      connectors_enabled && mkdir -p "$agents_data_dir/connectors"
      gateway_enabled && mkdir -p "$agents_data_dir/gateway"
      mkdir -p "$workspaces_root"
      $do_pull && _agents_dc pull
      local up_args=(up -d)
      if [[ -n "$CACERT_PATH" ]]; then
        up_args+=(--force-recreate)
      fi
      # Same lifecycle as the 7788 runtime: an agentic gateway already serving
      # on the port is REUSED — a container started over it cannot bind, and
      # the whole `up` would fail. Reuse applies only when the serving process
      # is EXTERNAL to this compose project (a native runner): if the compose
      # gateway container is the one running, the normal `up` leaves it alone.
      # Only an EXPLICIT `agents up gateway` asks for the container; then a
      # bind conflict is the honest answer.
      local gateway_scale=()
      local requested_list="${only_services[*]:-}"
      local gateway_container_running=false
      if _agents_dc ps --format '{{.Service}}' 2>/dev/null | grep -qx 'gateway'; then
        gateway_container_running=true
      fi
      if gateway_enabled && ! $gateway_container_running && ! [[ " $requested_list " == *" gateway "* ]] && gateway_serving; then
        printf 'Agentic gateway: already serving on :%s — reusing the existing runner (no container started).\n' "${GATEWAY_PORT:-7789}"
        gateway_scale=(--scale gateway=0)
      fi
      up_args+=(${gateway_scale[@]+"${gateway_scale[@]}"})
      up_args+=(${only_services[@]+"${only_services[@]}"})
      _agents_dc "${up_args[@]}"
      printf 'Workspaces root: %s\n' "$workspaces_root"
      printf 'Agents data:     %s\n' "$agents_data_dir"
      [[ -z "$CACERT_PATH" ]] || printf 'CA cert:         %s -> /wiki-manager-ca.pem\n' "$CACERT_PATH"
      printf 'Agents: cme=:%s  documents=:%s' \
        "${CME_MCP_PORT:-3336}" "${DOCUMENTS_MCP_PORT:-3337}"
      connectors_enabled && printf '  connectors=:%s' "${CONNECTORS_MCP_PORT:-3338}"
      gateway_enabled && printf '  gateway=:%s' "${GATEWAY_PORT:-7789}"
      printf '\n'
      [[ ! -f "$MANAGER_COMPOSE_DIR/agents.docker-compose.override.yml" ]] || printf 'User override: %s\n' "$MANAGER_COMPOSE_DIR/agents.docker-compose.override.yml"
      ;;
    down)
      # `down` sans argument démonte la pile ; avec des services nommés, Compose
      # n'accepte que `stop` + `rm` — `down <service>` supprime le réseau commun
      # et couperait les autres agents.
      if [[ $# -eq 0 ]]; then
        _agents_dc down
      else
        _agents_dc stop "$@"
        _agents_dc rm -f "$@"
      fi
      ;;
    purge)
      [[ $# -eq 0 ]] || die "agents purge does not take arguments"
      _agents_dc down --rmi all --remove-orphans
      ;;
    logs)
      local log_args=()
      read_lines_into_array log_args logs_args "$@"
      _agents_dc logs ${log_args[@]+"${log_args[@]}"}
      ;;
    pull)
      [[ $# -eq 0 ]] || die "agents pull does not take arguments"
      _agents_dc pull
      ;;
    refresh)
      [[ $# -eq 0 ]] || die "agents refresh does not take arguments"
      refresh_running_services 'No running external agent containers to refresh' 'Refreshed running agents: %s' _agents_dc
      ;;
    status)
      [[ $# -eq 0 ]] || die "agents status does not take arguments"
      if [[ ! -f "$MANAGER_ENDPOINTS_FILE" ]]; then
        printf 'No mcp.endpoints.json found at %s\n' "$MANAGER_ENDPOINTS_FILE" >&2
        exit 1
      fi
      command -v node >/dev/null 2>&1 || die "agents status requires node"
      node - "$MANAGER_ENDPOINTS_FILE" "$MANAGER_ENV_FILE" <<'NODE'
import fs from 'node:fs';

const [, , endpointsFile, envFile] = process.argv;

function parseEnvValue(value) {
  const trimmed = value.trim();
  if (trimmed.startsWith('"') && trimmed.endsWith('"')) return trimmed.slice(1, -1);
  if (trimmed.startsWith("'") && trimmed.endsWith("'")) return trimmed.slice(1, -1);
  return trimmed;
}

function loadEnv(filePath) {
  const values = { ...process.env };
  try {
    for (const raw of fs.readFileSync(filePath, 'utf8').split(/\r?\n/)) {
      const line = raw.trim();
      if (!line || line.startsWith('#')) continue;
      const index = line.indexOf('=');
      if (index === -1) continue;
      const key = line.slice(0, index).trim();
      if (!(key in values)) values[key] = parseEnvValue(line.slice(index + 1));
    }
  } catch (err) {
    if (err.code !== 'ENOENT') throw err;
  }
  return values;
}

function interpolate(value, env) {
  return String(value).replace(/\$\{([^}]+)\}/g, (_match, expr) => {
    const sep = expr.indexOf(':-');
    if (sep !== -1) return env[expr.slice(0, sep)] ?? expr.slice(sep + 2);
    return env[expr] ?? '';
  });
}

function runtimeUrl(url) {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === 'host.docker.internal') parsed.hostname = 'localhost';
    return parsed.toString();
  } catch {
    return url;
  }
}

function normalizeHeaders(headers, env) {
  if (!headers || typeof headers !== 'object' || Array.isArray(headers)) return {};
  return Object.fromEntries(
    Object.entries(headers)
      .filter(([key, value]) => key && typeof value === 'string' && value)
      .map(([key, value]) => [key.toLowerCase(), interpolate(value, env)]),
  );
}

async function check(url, headers) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 3000);
  try {
    const response = await fetch(runtimeUrl(url), {
      method: 'POST',
      signal: controller.signal,
      headers: {
        accept: 'application/json, text/event-stream',
        'content-type': 'application/json',
        ...headers,
      },
      body: JSON.stringify({
        jsonrpc: '2.0',
        id: 1,
        method: 'initialize',
        params: {
          protocolVersion: '2025-06-18',
          capabilities: {},
          clientInfo: { name: 'wiki-workspace', version: 'status' },
        },
      }),
    });
    await response.text();
    return response.ok;
  } catch {
    return false;
  } finally {
    clearTimeout(timeout);
  }
}

const env = loadEnv(envFile);
const config = JSON.parse(fs.readFileSync(endpointsFile, 'utf8'));
const servers = config.mcpServers ?? config.servers ?? {};

for (const [name, endpoint] of Object.entries(servers)) {
  const url = interpolate(endpoint?.url ?? '', env);
  if (!url) continue;
  const ok = await check(url, normalizeHeaders(endpoint.headers, env));
  console.log(`${name.padEnd(14)} ${url}  ${ok ? 'ok' : 'unreachable'}`);
}
NODE
      ;;
    *)
      die "unknown agents command: $subcommand (expected: up, down, logs, pull, status)"
      ;;
  esac
}

runtime_node_bin() {
  printf '%s\n' "${WIKI_MANAGER_NODE_BIN:-node}"
}

ensure_runtime_node() {
  local node_bin
  node_bin="$(runtime_node_bin)"
  command -v "$node_bin" >/dev/null 2>&1 || die "runtime requires Node.js 22+: command not found: $node_bin (set WIKI_MANAGER_NODE_BIN)"
  local version major
  version="$("$node_bin" -p 'process.versions.node' 2>/dev/null)" || die "could not execute Node runtime: $node_bin"
  major="${version%%.*}"
  [[ "$major" =~ ^[0-9]+$ && "$major" -ge 22 ]] || die "runtime requires Node.js 22+ for node:sqlite; $node_bin is Node $version"
}

ensure_agent_tokens() {
  # External agents authenticate with tokens
  # from the manager .env — generate any missing one, exactly like the
  # workspace and runtime tokens are generated. Leaving them empty made a
  # fresh install start agents nobody could talk to.
  local key token
  for key in CME_MCP_AUTH_TOKEN DOCUMENTS_MCP_AUTH_TOKEN GATEWAY_AUTH_TOKEN; do
    token="$(env_value "$MANAGER_ENV_FILE" "$key" "")"
    if [[ -z "$token" ]]; then
      token="$(generate_token)"
      mkdir -p "$(dirname "$MANAGER_ENV_FILE")"
      set_env_value "$MANAGER_ENV_FILE" "$key" "$token"
      printf 'Generated %s in %s\n' "$key" "$MANAGER_ENV_FILE"
    fi
  done
  if connectors_enabled; then
    # CONNECTORS_MCP_PORT ships as a commented placeholder, so enabling
    # connectors left the workspace stack interpolating an unset variable:
    # `The "CONNECTORS_MCP_PORT" variable is not set` on every compose command,
    # and serve advertising the connectors endpoint on a blank port. Pin the
    # value the agents stack is actually using so both stacks agree.
    if [[ -z "$(env_value "$MANAGER_ENV_FILE" CONNECTORS_MCP_PORT "")" ]]; then
      mkdir -p "$(dirname "$MANAGER_ENV_FILE")"
      set_env_value "$MANAGER_ENV_FILE" CONNECTORS_MCP_PORT "${CONNECTORS_MCP_PORT:-3338}"
      printf 'Pinned CONNECTORS_MCP_PORT=%s in %s\n' "${CONNECTORS_MCP_PORT:-3338}" "$MANAGER_ENV_FILE"
    fi
    for key in CONNECTORS_MCP_AUTH_TOKEN OAUTH_STATE_SECRET OAUTH_START_TOKEN; do
      token="$(env_value "$MANAGER_ENV_FILE" "$key" "")"
      if [[ -z "$token" ]]; then
        token="$(generate_token)"
        mkdir -p "$(dirname "$MANAGER_ENV_FILE")"
        set_env_value "$MANAGER_ENV_FILE" "$key" "$token"
        printf 'Generated %s in %s\n' "$key" "$MANAGER_ENV_FILE"
      fi
    done
    local callback_url connectors_port
    callback_url="$(env_value "$MANAGER_ENV_FILE" GOOGLE_OAUTH_CALLBACK_URL "")"
    if [[ -z "$callback_url" ]]; then
      connectors_port="$(env_value "$MANAGER_ENV_FILE" CONNECTORS_MCP_PORT "${CONNECTORS_MCP_PORT:-3338}")"
      callback_url="http://127.0.0.1:${connectors_port}/oauth/google/callback"
      set_env_value "$MANAGER_ENV_FILE" GOOGLE_OAUTH_CALLBACK_URL "$callback_url"
      printf 'Configured local GOOGLE_OAUTH_CALLBACK_URL in %s\n' "$MANAGER_ENV_FILE"
    fi
  fi
}

connectors_enabled() {
  local enabled
  enabled="$(env_value "$MANAGER_ENV_FILE" CONNECTORS_ENABLED "${CONNECTORS_ENABLED:-false}")"
  case "$enabled" in
    1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) return 0 ;;
    *) return 1 ;;
  esac
}

gateway_enabled() {
  local enabled
  enabled="$(env_value "$MANAGER_ENV_FILE" GATEWAY_ENABLED "${GATEWAY_ENABLED:-true}")"
  case "$enabled" in
    1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) return 0 ;;
    *) return 1 ;;
  esac
}

# Same lifecycle discipline as the 7788 runtime: an agentic gateway ALREADY
# serving on the port is REUSED, never shadowed by a container that cannot
# bind. A native `node bin/wiki-agentic-gateway.js` answers without auth
# (dev); a token-configured gateway (the container, or a native one with
# GATEWAY_AUTH_TOKEN) answers only to the Bearer — probe both.
gateway_serving() {
  local port="${GATEWAY_PORT:-7789}"
  local token url
  url="http://localhost:${port}/health"
  token="$(env_value "$MANAGER_ENV_FILE" GATEWAY_AUTH_TOKEN "")"
  if [[ -n "$token" ]]; then
    curl -fsS -m 3 -H "Authorization: Bearer $token" "$url" >/dev/null 2>&1 && return 0
  fi
  curl -fsS -m 3 "$url" >/dev/null 2>&1
}

ensure_endpoints_file() {
  # Without mcp.endpoints.json the shell never connects to the agents it
  # just started (and `agents status` refuses to run). Seed it from the
  # packaged example; the \${VAR} placeholders resolve against the .env.
  if [[ -e "$MANAGER_ENDPOINTS_FILE" && ! -f "$MANAGER_ENDPOINTS_FILE" ]]; then
    die "MCP endpoints path is not a file: $MANAGER_ENDPOINTS_FILE"
  fi
  if [[ ! -f "$MANAGER_ENDPOINTS_FILE" && -f "$ROOT_DIR/mcp.endpoints.example.json" ]]; then
    mkdir -p "$(dirname "$MANAGER_ENDPOINTS_FILE")"
    cp "$ROOT_DIR/mcp.endpoints.example.json" "$MANAGER_ENDPOINTS_FILE"
    printf 'Created %s from packaged example\n' "$MANAGER_ENDPOINTS_FILE"
  fi
  [[ -f "$MANAGER_ENDPOINTS_FILE" ]] || return
  local connector_state=false
  connectors_enabled && connector_state=true
  node - "$MANAGER_ENDPOINTS_FILE" "$connector_state" <<'NODE'
import fs from 'node:fs';

const [, , filePath, enabled] = process.argv;
const config = JSON.parse(fs.readFileSync(filePath, 'utf8'));
config.mcpServers ??= {};
config.chatAccess ??= { maxToolIterations: 8, servers: {} };
config.chatAccess.servers ??= {};
if (enabled === 'true') {
  config.mcpServers.connectors ??= {
    url: 'http://host.docker.internal:${CONNECTORS_MCP_PORT:-3338}/mcp/',
    headers: {
      Authorization: 'Bearer ${CONNECTORS_MCP_AUTH_TOKEN}',
    },
  };
  const connectorEndpoint = config.mcpServers.connectors;
  connectorEndpoint.requireApproval = [
    ...new Set([
      ...(Array.isArray(connectorEndpoint.requireApproval) ? connectorEndpoint.requireApproval : []),
      'connectors_gmail_modify',
    ]),
  ];
  config.chatAccess.servers.connectors ??= {};
  const connectorAccess = config.chatAccess.servers.connectors;
  // One shape for every server: a single `allow` list. The legacy
  // `allowActions` split is folded back in and removed, so a file written by
  // an older manager converges to the common shape on the next `agents up`.
  connectorAccess.allow = [
    ...new Set([
      ...(Array.isArray(connectorAccess.allow) ? connectorAccess.allow : []),
      ...(Array.isArray(connectorAccess.allowActions) ? connectorAccess.allowActions : []),
      'connectors_google_status',
      'connectors_google_oauth_start',
      'connectors_gmail_summary',
      'connectors_gmail_search',
      'connectors_gmail_labels',
    ]),
  ];
  delete connectorAccess.allowActions;
} else {
  delete config.mcpServers.connectors;
  delete config.chatAccess.servers.connectors;
}
fs.writeFileSync(filePath, `${JSON.stringify(config, null, 2)}\n`);
NODE
}

ensure_manager_runtime_token() {
  local token
  token="$(env_value "$MANAGER_ENV_FILE" WIKI_MANAGER_RUNTIME_TOKEN "")"
  if [[ -z "$token" ]]; then
    token="$(generate_token)"
    mkdir -p "$(dirname "$MANAGER_ENV_FILE")"
    set_env_value "$MANAGER_ENV_FILE" WIKI_MANAGER_RUNTIME_TOKEN "$token"
  fi
  printf '%s\n' "$token"
}

runtime_pid_file() {
  printf '%s/runtime.pid\n' "$MANAGER_RUNTIME_DIR"
}

runtime_log_file() {
  printf '%s/runtime.log\n' "$MANAGER_RUNTIME_DIR"
}

runtime_pid_running() {
  local pid_file pid
  pid_file="$(runtime_pid_file)"
  [[ -f "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

runtime_pid_command() {
  local pid="$1"
  ps -p "$pid" -o command= 2>/dev/null || ps -p "$pid" -o args= 2>/dev/null || true
}

runtime_command_looks_like_runtime() {
  local command="$1"
  [[ "$command" == *"/bin/wiki-manager.js runtime"* || "$command" == *" bin/wiki-manager.js runtime"* ]]
}

runtime_pid_matches() {
  local pid command
  pid="$(cat "$(runtime_pid_file)" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  command="$(runtime_pid_command "$pid")"
  runtime_command_looks_like_runtime "$command"
}

# Pids qui écoutent sur le port du runtime, quel que soit leur parent.
#
# Un runtime démarré par une session de shell précédente survit à la mort de
# cette session : il ne répond plus à notre jeton (401, donc « injoignable »)
# et son fichier pid a disparu avec l'ancien répertoire d'état. Sans ce repli,
# `runtime down` répond « not running » pendant que le port reste occupé, et il
# ne reste que le `kill` manuel — inacceptable pour qui utilise l'application.
runtime_port_pids() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | sort -u
  elif command -v ss >/dev/null 2>&1; then
    ss -lptnH "sport = :${port}" 2>/dev/null |
      grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u
  fi
}

# Arrête les runtimes orphelins tenant le port. Ne tue QUE des processus dont
# la ligne de commande est celle d'un `wiki-manager runtime` : un port occupé
# par autre chose est signalé, jamais tué.
runtime_kill_orphans() {
  local port="$1"
  local pid command stopped=0 waited
  while read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ "$pid" == "$$" ]] && continue
    command="$(runtime_pid_command "$pid")"
    if ! runtime_command_looks_like_runtime "$command"; then
      printf 'port %s is held by pid %s, which is not a wiki-manager runtime — leaving it alone\n' "$port" "$pid" >&2
      printf 'command: %s\n' "$command" >&2
      continue
    fi
    printf 'Stopping orphan agent-runtime (pid %s)\n' "$pid"
    kill "$pid" 2>/dev/null || true
    waited=0
    while kill -0 "$pid" 2>/dev/null && (( waited < 50 )); do
      sleep 0.1
      (( waited++ )) || true
    done
    if kill -0 "$pid" 2>/dev/null; then
      printf 'pid %s did not stop, sending SIGKILL\n' "$pid" >&2
      kill -9 "$pid" 2>/dev/null || true
    fi
    stopped=1
  done < <(runtime_port_pids "$port")
  (( stopped == 1 ))
}

runtime_port() {
  env_value "$MANAGER_ENV_FILE" WIKI_MANAGER_RUNTIME_PORT "${WIKI_MANAGER_RUNTIME_PORT:-7788}"
}

runtime_health_url() {
  printf 'http://127.0.0.1:%s/health\n' "$(runtime_port)"
}

runtime_health_check() {
  local token url
  token="$(env_value "$MANAGER_ENV_FILE" WIKI_MANAGER_RUNTIME_TOKEN "")"
  url="$(runtime_health_url)"
  if command -v curl >/dev/null 2>&1; then
    if [[ -n "$token" ]]; then
      curl -fsS -H "Authorization: Bearer $token" "$url" >/dev/null 2>&1
    else
      curl -fsS "$url" >/dev/null 2>&1
    fi
    return
  fi
  local node_bin
  node_bin="$(runtime_node_bin)"
  RUNTIME_URL="$url" RUNTIME_TOKEN="$token" "$node_bin" --input-type=module -e "const h=process.env.RUNTIME_TOKEN?{Authorization:'Bearer '+process.env.RUNTIME_TOKEN}:{}; const r=await fetch(process.env.RUNTIME_URL,{headers:h}); process.exit(r.ok?0:1);"
}

wait_for_runtime_health() {
  local attempts="${1:-60}"
  local i=0
  while (( i < attempts )); do
    runtime_health_check && return 0
    runtime_pid_running || return 1
    sleep 0.25
    (( i++ )) || true
  done
  return 1
}

runtime_command() {
  local subcommand="$1"
  shift
  local host="${WIKI_MANAGER_RUNTIME_HOST:-0.0.0.0}"
  local port
  port="$(runtime_port)"
  local pid_file log_file node_bin token
  pid_file="$(runtime_pid_file)"
  log_file="$(runtime_log_file)"
  node_bin="$(runtime_node_bin)"

  case "$subcommand" in
    up)
      [[ $# -eq 0 ]] || die "runtime up does not take arguments"
      mkdir -p "$MANAGER_RUNTIME_DIR"
      ensure_runtime_node
      token="$(ensure_manager_runtime_token)"
      export WIKI_MANAGER_RUNTIME_TOKEN="$token"
      if runtime_health_check; then
        printf 'agent-runtime already healthy at %s\n' "$(runtime_health_url)"
        return
      fi
      if runtime_pid_running; then
        printf 'Waiting for agent-runtime process (pid %s)...\n' "$(cat "$pid_file")"
      else
        # Le port peut être tenu par un runtime d'une session précédente, qui
        # répond 401 à notre jeton : la sonde de santé le croit absent, et le
        # démarrage se solderait par un EADDRINUSE incompréhensible. On le
        # remplace, puisque `runtime up` veut précisément un runtime ici.
        if [[ -n "$(runtime_port_pids "$port")" ]]; then
          printf 'Port %s is already held by an unreachable agent-runtime.\n' "$port"
          runtime_kill_orphans "$port" || true
        fi
        WIKI_WORKSPACES_DIR="$WORKSPACES_DIR" \
        WIKI_MANAGER_ENV_FILE="$MANAGER_ENV_FILE" \
        WIKI_MANAGER_STATE_DIR="$MANAGER_RUNTIME_DIR" \
        WIKI_MANAGER_RUNTIME_TOKEN="$token" \
        nohup "$node_bin" "$ROOT_DIR/bin/wiki-manager.js" runtime --host "$host" --port "$port" --state-dir "$MANAGER_RUNTIME_DIR" > "$log_file" 2>&1 &
        printf '%s\n' "$!" > "$pid_file"
      fi
      if ! wait_for_runtime_health; then
        printf 'agent-runtime failed to become healthy at %s\n' "$(runtime_health_url)" >&2
        [[ ! -f "$log_file" ]] || tail -20 "$log_file" >&2
        return 1
      fi
      printf 'agent-runtime healthy on http://127.0.0.1:%s (pid %s)\n' "$port" "$(cat "$pid_file")"
      printf 'state: %s\nlog:   %s\n' "$MANAGER_RUNTIME_DIR" "$log_file"
      ;;
    down|stop)
      [[ $# -eq 0 ]] || die "runtime down does not take arguments"
      token="$(ensure_manager_runtime_token)"
      if runtime_health_check; then
        RUNTIME_URL="$(runtime_health_url)/shutdown" RUNTIME_TOKEN="$token" "$node_bin" --input-type=module -e \
          "const h=process.env.RUNTIME_TOKEN?{Authorization:'Bearer '+process.env.RUNTIME_TOKEN}:{}; const r=await fetch(process.env.RUNTIME_URL,{method:'POST',headers:h}); process.exit(r.ok?0:1);"
        local wait_count=0
        while runtime_health_check && (( wait_count < 40 )); do
          sleep 0.1
          (( wait_count++ )) || true
        done
        # Un arrêt propre refusé laissait le port occupé sans le dire.
        if runtime_health_check; then
          printf 'agent-runtime ignored the shutdown request; stopping the process\n' >&2
          runtime_kill_orphans "$port" || true
        fi
        rm -f "$pid_file"
        printf 'agent-runtime stopped\n'
        return
      fi
      if ! runtime_pid_running; then
        # Ni sain, ni référencé par un pid : reste le port. C'est le cas d'un
        # orphelin, qu'on ne peut pas demander à l'utilisateur de tuer.
        if runtime_kill_orphans "$port"; then
          rm -f "$pid_file"
          printf 'agent-runtime stopped\n'
          return
        fi
        printf 'agent-runtime is not running (no healthy endpoint, no pid in %s, nothing listening on port %s)\n' "$pid_file" "$port"
        rm -f "$pid_file"
        return
      fi
      if ! runtime_pid_matches; then
        printf 'refusing to stop pid %s: command does not look like wiki-manager runtime\n' "$(cat "$pid_file")" >&2
        printf 'command: %s\n' "$(runtime_pid_command "$(cat "$pid_file")")" >&2
        rm -f "$pid_file"
        exit 1
      fi
      kill "$(cat "$pid_file")"
      rm -f "$pid_file"
      printf 'agent-runtime stopped\n'
      ;;
    status)
      [[ $# -eq 0 ]] || die "runtime status does not take arguments"
      if runtime_health_check; then
        printf 'agent-runtime healthy at %s\n' "$(runtime_health_url)"
      elif runtime_pid_running; then
        printf 'agent-runtime process running (pid %s), health check failed\n' "$(cat "$pid_file")"
        exit 1
      else
        local orphan_pids
        orphan_pids="$(runtime_port_pids "$port")"
        if [[ -n "$orphan_pids" ]]; then
          # Le symptôme perçu comme « ça ne démarre pas » : quelqu'un tient le
          # port et répond 401 à notre jeton, donc les sondes le voient absent.
          printf 'agent-runtime is not reachable with this token, but pid(s) %s hold port %s\n' \
            "$(printf '%s' "$orphan_pids" | tr '\n' ' ')" "$port"
          printf 'run `%s runtime down` to stop it\n' "$(basename "$0")"
          exit 1
        fi
        printf 'agent-runtime is not running\n'
        exit 1
      fi
      ;;
    logs)
      if [[ ! -f "$log_file" ]]; then
        printf 'No runtime log found at %s\n' "$log_file" >&2
        exit 1
      fi
      if [[ $# -eq 0 ]]; then
        tail -100 -f "$log_file"
      else
        tail "$@" "$log_file"
      fi
      ;;
    *)
      die "unknown runtime command: $subcommand (expected: up, down, status, logs)"
      ;;
  esac
}

refresh_project() {
  printf 'Stopping shared runtime...\n'
  runtime_command down

  local entry workspace
  for entry in "$WORKSPACES_DIR"/*; do
    [[ -f "$entry/.env" ]] || continue
    workspace="$(basename "$entry")"
    printf 'Removing workspace stack and images: %s\n' "$workspace"
    compose_for_workspace "$workspace" down --rmi all --remove-orphans
  done

  printf 'Removing external-agent stack and images...\n'
  agents_compose purge

  # `refresh` promet un état propre : le vérifier plutôt que l'affirmer. Un
  # port encore tenu ici signifie qu'il l'est par un processus étranger, que
  # `runtime down` refuse de tuer à raison — mais le taire ferait échouer le
  # prochain démarrage sans que personne ne fasse le lien.
  local leftover
  leftover="$(runtime_port_pids "$(runtime_port)")"
  if [[ -n "$leftover" ]]; then
    printf 'Refresh incomplete: port %s is still held by pid(s) %s.\n' \
      "$(runtime_port)" "$(printf '%s' "$leftover" | tr '\n' ' ')" >&2
    printf 'It is not a wiki-manager runtime, so it was left running. Free the port, or set WIKI_MANAGER_RUNTIME_PORT to another one.\n' >&2
    return 1
  fi
  printf 'Refresh complete. Persistent workspace and agent data were preserved.\n'
}

ensure_runtime_up() {
  if [[ "${WIKI_MANAGER_RUNTIME_AUTOSTART:-1}" == "0" ]]; then
    return
  fi
  if runtime_health_check; then
    return
  fi
  printf 'Starting host agent-runtime...\n'
  runtime_command up
}

start_workspace_services() {
  ensure_runtime_up
  compose_for_workspace "$1" up -d serve mcp-http production-mcp
}

ensure_compose_override() {
  # User-owned compose overrides. Seeded ONCE from the packaged example and
  # never rewritten afterwards — the opposite policy from
  # .wiki/runtime/*.cacert.compose.yml, which is generated state and must always
  # be replaced. Without a file scaffolded up front, operators hit a corporate
  # proxy or a missing mount and have no supported place to fix it, so they edit
  # the generated override and lose the change on the next compose command.
  local example_name="$1"
  local target_name="$2"
  local target="$MANAGER_COMPOSE_DIR/$target_name"
  local legacy="$MANAGER_STATE_DIR/$target_name"
  [[ -f "$target" ]] && return 0
  mkdir -p "$MANAGER_COMPOSE_DIR"
  if [[ -f "$legacy" ]]; then
    mv "$legacy" "$target"
    printf 'Migrated user-owned compose override: %s -> %s\n' "$legacy" "$target" >&2
    return 0
  fi
  [[ -f "$ROOT_DIR/$example_name" ]] || return 0
  cp "$ROOT_DIR/$example_name" "$target"
  printf 'Created %s (user-owned compose override, never regenerated)\n' "$target" >&2
}

ensure_manager_endpoints_file() {
  if [[ -e "$MANAGER_ENDPOINTS_FILE" && ! -f "$MANAGER_ENDPOINTS_FILE" ]]; then
    die "MCP endpoints path is not a file: $MANAGER_ENDPOINTS_FILE"
  fi
  if [[ ! -f "$MANAGER_ENDPOINTS_FILE" && -f "$ROOT_DIR/mcp.endpoints.example.json" ]]; then
    mkdir -p "$(dirname "$MANAGER_ENDPOINTS_FILE")"
    cp "$ROOT_DIR/mcp.endpoints.example.json" "$MANAGER_ENDPOINTS_FILE"
    printf 'Created %s (from mcp.endpoints.example.json — add headers/tokens as needed)\n' "$MANAGER_ENDPOINTS_FILE"
  fi
}

workspace_value() {
  local workspace="$1"
  local key="$2"
  local default="${3-}"
  env_value "$(workspace_env_file "$workspace")" "$key" "$default"
}

used_workspace_ports() {
  local entry file key val
  for entry in "$WORKSPACES_DIR"/*; do
    [[ -d "$entry" ]] || continue
    file="$entry/.env"
    [[ -f "$file" ]] || continue
    for key in WIKI_SERVE_PORT WIKI_MCP_PORT PRODUCTION_MCP_PORT; do
      val="$(env_value "$file" "$key" "")"
      [[ "$val" =~ ^[0-9]+$ ]] && printf '%s\n' "$val"
    done
  done
}

is_port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tln 2>/dev/null | grep -q ":${port} "
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
  else
    (echo >/dev/tcp/127.0.0.1/"$port") 2>/dev/null
  fi
}

find_free_port() {
  local start="${1:-3100}"
  local port="$start"
  local used_ports=()
  read_lines_into_array used_ports used_workspace_ports
  while true; do
    local taken=0 p
    if (( ${#used_ports[@]} > 0 )); then
      for p in "${used_ports[@]}"; do
        [[ "$p" == "$port" ]] && { taken=1; break; }
      done
    fi
    if [[ "$taken" -eq 0 ]] && ! is_port_in_use "$port"; then
      printf '%s\n' "$port"
      return 0
    fi
    port=$((port + 1))
  done
}

find_free_workspace_port_base() {
  local base="${1:-3100}"
  local used_ports=()
  read_lines_into_array used_ports used_workspace_ports
  while true; do
    local taken=0 offset port p
    for offset in 0 1 2; do
      port=$((base + offset))
      if (( ${#used_ports[@]} > 0 )); then
        for p in "${used_ports[@]}"; do
          [[ "$p" == "$port" ]] && { taken=1; break; }
        done
      fi
      [[ "$taken" -eq 1 ]] && break
      if is_port_in_use "$port"; then
        taken=1
        break
      fi
    done
    if [[ "$taken" -eq 0 ]]; then
      printf '%s\n' "$base"
      return 0
    fi
    base=$((base + 100))
  done
}

list_workspaces() {
  mkdir -p "$WORKSPACES_DIR"
  local found=0 entry file name path serve mcp prod

  for entry in "$WORKSPACES_DIR"/*; do
    [[ -d "$entry" ]] || continue
    file="$entry/.env"
    [[ -f "$file" ]] || continue
    found=1
    name="$(env_value "$file" WORKSPACE_NAME "$(basename "$entry")")"
    path="$(env_value "$file" WIKI_WORKSPACE_PATH "-")"
    serve="$(env_value "$file" WIKI_SERVE_PORT "-")"
    mcp="$(env_value "$file" WIKI_MCP_PORT "-")"
    prod="$(env_value "$file" PRODUCTION_MCP_PORT "-")"
    printf '%s\tpath=%s\tserve=%s\tmcp=%s\tprod=%s\n' \
      "$name" "$path" "$serve" "$mcp" "$prod"
  done

  [[ "$found" -eq 1 ]] || printf 'No workspaces configured in %s\n' "$WORKSPACES_DIR"
}

compose_project() {
  local workspace="$1"
  printf 'wiki-%s' "$workspace" | tr -c '[:alnum:]_-' '-'
}

compose_for_workspace() {
  local workspace="$1"
  shift
  need_workspace_env "$workspace"
  ensure_compose_override 'docker-compose.override.example.yml' 'docker-compose.override.yml'
  local workspace_env ws_path serve_port mcp_port prod_port project agents_data_dir
  workspace_env="$(workspace_env_file "$workspace")"
  ws_path="$(normalize_path "$(workspace_value "$workspace" WIKI_WORKSPACE_PATH)")"
  serve_port="$(workspace_value "$workspace" WIKI_SERVE_PORT 3100)"
  mcp_port="$(workspace_value "$workspace" WIKI_MCP_PORT 3101)"
  prod_port="$(workspace_value "$workspace" PRODUCTION_MCP_PORT 3102)"
  project="$(compose_project "$workspace")"
  # Same canonical rule as agents_compose: .agents-data next to the workspaces.
  agents_data_dir="$(absolute_path "${AGENTS_DATA_DIR:-$(dirname "$ws_path")/.agents-data}" "$DEFAULT_MANAGER_DIR")"

  local compose_env_args=()
  [[ -f "$MANAGER_ENV_FILE" ]] && compose_env_args+=(--env-file "$MANAGER_ENV_FILE")
  compose_env_args+=(--env-file "$workspace_env")
  local cacert_args=()
  WIKI_WORKSPACE_PATH="$ws_path" \
  WIKI_SERVE_PORT="$serve_port" \
  WIKI_MCP_PORT="$mcp_port" \
  PRODUCTION_MCP_PORT="$prod_port" \
    read_lines_into_array cacert_args cacert_compose_args "$ROOT_DIR/docker-compose.yml" "cacert.compose.yml"
  # Same contract as the agents stack: a single global user-owned override in
  # .wiki/compose, merged after the packaged file and before the generated CA
  # override so the operator can still be overruled on CA paths only.
  local override_args=()
  local user_override="$MANAGER_COMPOSE_DIR/docker-compose.override.yml"
  [[ -f "$user_override" ]] && override_args+=(-f "$user_override")

  WIKI_WORKSPACE_PATH="$ws_path" \
  WIKI_SERVE_PORT="$serve_port" \
  WIKI_MCP_PORT="$mcp_port" \
  PRODUCTION_MCP_PORT="$prod_port" \
  AGENTS_DATA_DIR="$agents_data_dir" \
  docker compose --project-directory "$DEFAULT_MANAGER_DIR" \
    ${compose_env_args[@]+"${compose_env_args[@]}"} -f "$ROOT_DIR/docker-compose.yml" ${override_args[@]+"${override_args[@]}"} ${cacert_args[@]+"${cacert_args[@]}"} -p "$project" "$@"
}

logs_args() {
  if [[ $# -eq 0 ]]; then
    printf '%s\n' --tail=100 -f
  else
    printf '%s\n' "$@"
  fi
}


read_lines_into_array() {
  local array_name="$1"
  shift
  [[ "$array_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid array name: $array_name"

  eval "$array_name=()"
  local line
  while IFS= read -r line; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    eval "$array_name+=(\"\$line\")"
  done < <("$@")
}

# Shared by the "agents refresh" and per-workspace "refresh" subcommands:
# pull and recreate only the compose services already running, skipping the
# rest. "$@" is the compose invocation (e.g. `_agents_dc` or
# `compose_for_workspace "$workspace"`) to run ps/pull/up through.
refresh_running_services() {
  local no_running_msg="$1"
  local refreshed_msg_fmt="$2"
  shift 2
  local running_services=()
  read_lines_into_array running_services "$@" ps --status running --services
  if [[ ${#running_services[@]} -eq 0 ]]; then
    printf '%s\n' "$no_running_msg"
    return
  fi
  "$@" pull "${running_services[@]}"
  "$@" up -d "${running_services[@]}"
  printf "$refreshed_msg_fmt\n" "${running_services[*]}"
}

cacert_compose_args() {
  local compose_file="$1"
  local override_name="$2"
  [[ -n "$CACERT_PATH" ]] || return 0

  local services
  services="$(
    awk '
      /^[[:space:]]*services:[[:space:]]*$/ { in_services=1; next }
      in_services && /^[^[:space:]#]/ { exit }
      in_services && /^  [A-Za-z0-9_.-]+:[[:space:]]*$/ {
        line=$0
        sub(/^  /, "", line)
        sub(/:[[:space:]]*$/, "", line)
        print line
      }
    ' "$compose_file"
  )"
  [[ -n "$services" ]] || return 0

  mkdir -p "$MANAGER_RUNTIME_DIR"
  local override_path="$MANAGER_RUNTIME_DIR/$override_name"
  local tmp_override="$override_path.tmp.$$"
  {
    printf '# Generated by wiki-manager. Changes are overwritten on the next compose command.\n'
    printf 'services:\n'
    while IFS= read -r service || [[ -n "$service" ]]; do
      [[ -n "$service" ]] || continue
      printf '  %s:\n' "$service"
      printf '    volumes:\n'
      printf '      - %s:/wiki-manager-ca.pem:ro\n' "$CACERT_PATH"
      printf '    environment:\n'
      printf '      NODE_EXTRA_CA_CERTS: /wiki-manager-ca.pem\n'
      printf '      SSL_CERT_FILE: /wiki-manager-ca.pem\n'
      printf '      REQUESTS_CA_BUNDLE: /wiki-manager-ca.pem\n'
      printf '      CURL_CA_BUNDLE: /wiki-manager-ca.pem\n'
    done <<< "$services"
  } > "$tmp_override"
  # Always replace generated state: package updates may add/remove services,
  # and retaining an older override creates invalid phantom services.
  mv "$tmp_override" "$override_path"
  printf '%s\n' -f "$override_path"
}

run_wiki() {
  local workspace="$1"
  shift
  need_workspace_env "$workspace"
  local ws_path
  ws_path="$(normalize_path "$(workspace_value "$workspace" WIKI_WORKSPACE_PATH)")"
  ensure_workspace_dirs "$ws_path"
  compose_for_workspace "$workspace" run --rm wiki "$@"
}

# What `wiki <workspace> reset` keeps: the METHOD. `.wikirc*` (provider, model,
# retrieval, per-profile variants), `templates/` and `build-context/` describe
# how this workspace produces; everything else is what it has produced, cached
# or logged. `.git/` is kept too — the history from before the reset stays
# reachable through `wiki restore`, which is the only cheap undo there is.
#
# `.env` is kept for a harder reason than method: it IS the workspace's
# registration — ports, MCP auth tokens, WIKI_WORKSPACE_PATH. Deleting it makes
# the very next line of reset_workspace (`run_wiki … init`, which starts with
# need_workspace_env) die under `set -euo pipefail`, leaving the workspace
# emptied and never re-scaffolded. And recovering it with `config` mints new
# ports and tokens, silently invalidating every reference to the old ones
# (mcp.endpoints.json among them). Nothing here may drop it.
workspace_reset_keep() {
  case "$1" in
    .|..|.git) return 0 ;;
    .env|.env.*) return 0 ;;
    .wikirc*) return 0 ;;
    templates|build-context) return 0 ;;
    *) return 1 ;;
  esac
}

# Destructive, and deliberately reachable ONLY from this CLI: no `wiki reset`
# subcommand, no production job type, no MCP tool, no skill. Nothing Donna can
# call may erase a workspace.
#
# It also stops after re-scaffolding. Chaining a sync or a build here would be
# convenient exactly once and wrong every other time: refilling the workspace
# is the user's decision, not a side effect of emptying it.
reset_workspace() {
  local workspace="$1"
  shift
  local assume_yes=0 dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) assume_yes=1 ;;
      --dry-run) dry_run=1 ;;
      *) die "reset accepts only --yes and --dry-run (got: $1)" ;;
    esac
    shift
  done

  need_workspace_env "$workspace"
  local ws_path
  ws_path="$(normalize_path "$(workspace_value "$workspace" WIKI_WORKSPACE_PATH)")"
  [[ -d "$ws_path" ]] || die "workspace directory not found: $ws_path"

  # A container still writing into the bind mount would recreate part of what
  # we just erased, and leave files owned by another UID behind.
  local running_services=()
  read_lines_into_array running_services compose_for_workspace "$workspace" ps --status running --services
  if [[ ${#running_services[@]} -gt 0 ]]; then
    die "workspace services are still running (${running_services[*]}) — stop them first: wiki-workspace wiki $workspace down"
  fi

  local entry name
  local removed=() kept=()
  for entry in "$ws_path"/* "$ws_path"/.*; do
    [[ -e "$entry" ]] || continue
    name="$(basename "$entry")"
    if workspace_reset_keep "$name"; then
      [[ "$name" == "." || "$name" == ".." ]] || kept+=("$name")
      continue
    fi
    removed+=("$name")
  done

  printf 'Workspace: %s (%s)\n' "$workspace" "$ws_path"
  printf 'Keep:   %s\n' "${kept[*]:-(nothing)}"
  printf 'Reset:  %s\n' "${removed[*]:-(nothing)}"

  if [[ ${#removed[@]} -eq 0 ]]; then
    printf 'Nothing to reset.\n'
    return
  fi

  if [[ $dry_run -eq 1 ]]; then
    printf 'Dry run: nothing was deleted. Re-run without --dry-run to apply.\n'
    return
  fi

  if [[ $assume_yes -eq 0 ]]; then
    [[ -t 0 ]] || die "reset needs a terminal to confirm — pass --yes for a non-interactive run"
    printf 'This deletes the wiki, the deliverables and the sources. Type the workspace name to confirm (%s): ' "$workspace"
    local answer=''
    IFS= read -r answer || true
    [[ "$answer" == "$workspace" ]] || die "reset aborted"
  fi

  for name in "${removed[@]}"; do
    rm -rf -- "${ws_path:?}/$name" \
      || die "could not remove $ws_path/$name — check file ownership (containers run as the node user), then retry"
  done

  # Puts the structure back: empty raw/wiki/deliverables trees, .wiki/skills,
  # system-prompt, an empty profile, CLAUDE.md, .gitignore, and a fresh history
  # baseline. `wiki init` never overwrites an existing file, so the kept
  # `.wikirc*`, templates/ and build-context/ come through untouched.
  run_wiki "$workspace" init

  # The scaffold ships a handful of demo-*.md sources in raw/untracked/ (a
  # project brief plus a few notes chosen to classify into different concepts
  # with overlapping subjects/tags, so a first ingest already produces a
  # non-trivial graph). Reappearing here they would not read as samples but as
  # pending sources, and the next ingest would file them into the wiki as if
  # the user had provided them.
  rm -f -- "$ws_path"/raw/untracked/demo-*.md

  printf 'Reset done: %s\n' "$workspace"
  printf 'Kept: %s\n' "${kept[*]:-(nothing)}"
  printf 'Nothing was rebuilt. Bring the sources back when you decide to (e.g. /wiki-sync), then build.\n'
}

open_app_mode() {
  local url="$1"
  case "$(uname -s)" in
    Darwin)
      open -na "Google Chrome" --args "--app=${url}" 2>/dev/null \
        || open -na "Microsoft Edge" --args "--app=${url}" 2>/dev/null \
        || open -a Safari "${url}" 2>/dev/null \
        || open "${url}"
      ;;
    Linux)
      # WSL2: Windows browsers are not on PATH — probe known Windows paths via wslpath.
      if command -v wslpath >/dev/null 2>&1; then
        local wsl_candidate wsl_path
        for wsl_candidate in \
          "C:/Program Files/Google/Chrome/Application/chrome.exe" \
          "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe" \
          "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe" \
          "C:/Program Files/Microsoft/Edge/Application/msedge.exe"; do
          wsl_path="$(wslpath -u "$wsl_candidate" 2>/dev/null)" || continue
          [[ -f "$wsl_path" ]] || continue
          "$wsl_path" "--app=${url}" &
          return
        done
        for wsl_candidate in \
          "C:/Program Files/Mozilla Firefox/firefox.exe"; do
          wsl_path="$(wslpath -u "$wsl_candidate" 2>/dev/null)" || continue
          [[ -f "$wsl_path" ]] || continue
          "$wsl_path" "${url}" &
          return
        done
      fi
      for candidate in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge microsoft-edge-stable; do
        if command -v "$candidate" >/dev/null 2>&1; then
          "$candidate" "--app=${url}" &
          return
        fi
      done
      xdg-open "${url}" 2>/dev/null || true
      ;;
    MINGW*|MSYS*|CYGWIN*)
      for candidate in \
        "C:/Program Files/Google/Chrome/Application/chrome.exe" \
        "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe" \
        "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe" \
        "C:/Program Files/Microsoft/Edge/Application/msedge.exe"; do
        if [[ -f "$candidate" ]]; then
          "$candidate" "--app=${url}" &
          return
        fi
      done
      for candidate in \
        "C:/Program Files/Mozilla Firefox/firefox.exe"; do
        if [[ -f "$candidate" ]]; then
          "$candidate" "${url}" &
          return
        fi
      done
      start "" "${url}" || true
      ;;
  esac
}

wait_and_open() {
  local url="$1"
  local max_attempts=30
  local i=0
  while (( i < max_attempts )); do
    sleep 1
    if curl -sf "${url}" >/dev/null 2>&1; then
      open_app_mode "${url}"
      return
    fi
    (( i++ )) || true
  done
  printf 'wiki-workspace: server did not become ready at %s after %ds, opening anyway\n' "${url}" "$max_attempts" >&2
  open_app_mode "${url}"
}

# `start` — the whole deployment in one command: the host agent-runtime, the
# external agents, then every configured workspace stack. Each step is the
# same idempotent command the operator would run by hand, so `start` is safe
# to repeat while things are already up. A workspace failure stops the run —
# the failing compose command already says why.
start_all() {
  local open_browser="${1:-0}"

  printf -- '── agent-runtime ──\n'
  runtime_command up
  printf '\n'

  printf -- '── external agents ──\n'
  agents_compose up
  printf '\n'

  mkdir -p "$WORKSPACES_DIR"
  local found=0 first_name="" entry file name
  for entry in "$WORKSPACES_DIR"/*; do
    [[ -d "$entry" ]] || continue
    file="$entry/.env"
    [[ -f "$file" ]] || continue
    name="$(env_value "$file" WORKSPACE_NAME "$(basename "$entry")")"
    found=1
    [[ -n "$first_name" ]] || first_name="$name"
    printf -- '── workspace: %s ──\n' "$name"
    up_workspace "$name"
    printf '\n'
  done

  if [[ "$found" -eq 0 ]]; then
    printf 'No workspaces configured in %s\n' "$WORKSPACES_DIR"
    printf 'Create one with: wiki-workspace config <name>\n'
    return 0
  fi

  if [[ "$open_browser" == "1" ]]; then
    local serve_port
    serve_port="$(workspace_value "$first_name" WIKI_SERVE_PORT 3100)"
    wait_and_open "http://localhost:${serve_port}/chat" &
  fi
}

ensure_workspace_dirs() {
  local ws_path="$1"
  mkdir -p "$ws_path/.wiki/vector-index"
  mkdir -p "$ws_path/raw/untracked"
  # The llm-wiki container runs as the unprivileged `node` user. On WSL2,
  # Rancher Desktop, and bind mounts created by the host, runtime folders can
  # end up owned by a different UID and become read-only from the container.
  chmod -R a+rwX "$ws_path/.wiki" "$ws_path/raw" 2>/dev/null || true
}

register_workspace_path() {
  local workspace="$1"
  local target_path="$2"
  local registry_path registry_abs
  registry_path="$WORKSPACES_DIR/$workspace"
  registry_abs="$(absolute_path "$registry_path")"

  [[ "$target_path" == "$registry_abs" ]] && return 0

  mkdir -p "$WORKSPACES_DIR"
  if [[ -e "$registry_path" || -L "$registry_path" ]]; then
    die "workspace registry path already exists: $registry_path"
  fi
  ln -s "$target_path" "$registry_path"
  printf 'Registered %s -> %s\n' "$registry_path" "$target_path"
}

config_workspace() {
  local workspace="$1"
  local target_path="${2:-$WORKSPACES_DIR/$workspace}"
  target_path="$(absolute_path "$target_path")"
  ensure_manager_endpoints_file
  ensure_compose_override 'docker-compose.override.example.yml' 'docker-compose.override.yml'
  ensure_compose_override 'agents.docker-compose.override.example.yml' 'agents.docker-compose.override.yml'

  local env_file="$target_path/.env"
  [[ -f "$env_file" ]] && die "workspace already configured: $env_file"

  local port_base serve_port mcp_port prod_port wiki_token prod_token agents_data_dir
  # Same canonical rule as agents_compose: .agents-data next to the workspaces.
  agents_data_dir="$(absolute_path "${AGENTS_DATA_DIR:-$(dirname "$target_path")/.agents-data}" "$DEFAULT_MANAGER_DIR")"
  port_base="$(find_free_workspace_port_base 3100)"
  serve_port="$port_base"
  mcp_port=$((port_base + 1))
  prod_port=$((port_base + 2))
  wiki_token="$(generate_token)"
  prod_token="$(generate_token)"

  mkdir -p "$target_path"
  register_workspace_path "$workspace" "$target_path"
  ensure_workspace_dirs "$target_path"
  # Ensure the container (node, UID 1000) can write to the workspace.
  # Needed on WSL2 when the host UID differs from the container UID.
  chmod -R a+rwX "$target_path" 2>/dev/null || true

  printf 'WORKSPACE_NAME=%s\nWIKI_WORKSPACE_PATH=%s\nWIKI_SERVE_PORT=%s\nWIKI_MCP_PORT=%s\nPRODUCTION_MCP_PORT=%s\nPRODUCTION_REQUIRE_CONFIRMATION=false\nWIKI_MCP_AUTH_TOKEN=%s\nPRODUCTION_MCP_AUTH_TOKEN=%s\n' \
    "$workspace" "$target_path" "$serve_port" "$mcp_port" "$prod_port" "$wiki_token" "$prod_token" \
    > "$env_file"

  printf 'Created %s\n' "$env_file"
  printf 'Ports  serve=%s  mcp=%s  production=%s\n' \
    "$serve_port" "$mcp_port" "$prod_port"

  local compose_env_args=()
  [[ -f "$MANAGER_ENV_FILE" ]] && compose_env_args+=(--env-file "$MANAGER_ENV_FILE")
  compose_env_args+=(--env-file "$env_file")
  local cacert_args=()
  WIKI_WORKSPACE_PATH="$target_path" \
  WIKI_SERVE_PORT="$serve_port" \
  WIKI_MCP_PORT="$mcp_port" \
    read_lines_into_array cacert_args cacert_compose_args "$ROOT_DIR/docker-compose.yml" "cacert.compose.yml"
  local override_args=()
  local user_override="$MANAGER_COMPOSE_DIR/docker-compose.override.yml"
  [[ -f "$user_override" ]] && override_args+=(-f "$user_override")

  WIKI_WORKSPACE_PATH="$target_path" \
  WIKI_SERVE_PORT="$serve_port" \
  WIKI_MCP_PORT="$mcp_port" \
  AGENTS_DATA_DIR="$agents_data_dir" \
    docker compose --project-directory "$DEFAULT_MANAGER_DIR" \
      ${compose_env_args[@]+"${compose_env_args[@]}"} -f "$ROOT_DIR/docker-compose.yml" ${override_args[@]+"${override_args[@]}"} ${cacert_args[@]+"${cacert_args[@]}"} run --rm wiki init

  printf 'Workspace ready: %s\n' "$target_path"
  printf 'Start with:      wiki-workspace up %s\n' "$workspace"
}

up_workspace() {
  local workspace="$1"
  local open_browser="${2:-0}"
  need_workspace_env "$workspace"
  local ws_path
  ws_path="$(normalize_path "$(workspace_value "$workspace" WIKI_WORKSPACE_PATH)")"
  ensure_workspace_dirs "$ws_path"
  start_workspace_services "$workspace"

  local serve_port prod_port
  serve_port="$(workspace_value "$workspace" WIKI_SERVE_PORT 3100)"
  prod_port="$(workspace_value "$workspace" PRODUCTION_MCP_PORT 3102)"
  printf 'Workspace UI: http://localhost:%s\n' "$serve_port"
  printf 'Chat:         http://localhost:%s/chat\n' "$serve_port"
  printf 'Production:   http://localhost:%s/mcp/\n' "$prod_port"
  printf 'Runtime:      %s\n' "$(runtime_health_check && printf 'healthy at %s' "$(runtime_health_url)" || printf 'start with: wiki-workspace runtime up')"
  printf 'External MCPs: see %s\n' "$MANAGER_ENDPOINTS_FILE"

  if [[ "$open_browser" == "1" ]]; then
    wait_and_open "http://localhost:${serve_port}/chat" &
  fi
}

main() {
  if [[ $# -eq 1 && "$1" =~ ^(-h|--help|help)$ ]]; then
    usage
    exit 0
  fi

  if [[ $# -eq 1 && "$1" == "list" ]]; then
    list_workspaces
    exit 0
  fi

  if [[ $# -eq 1 && "$1" == "refresh" ]]; then
    refresh_project
    exit 0
  fi

  # config <workspace> [path]
  if [[ $# -ge 2 && "$1" == "config" ]]; then
    local cfg_workspace="$2"
    local cfg_path="${3:-}"
    if [[ -n "$cfg_path" ]]; then
      config_workspace "$cfg_workspace" "$cfg_path"
    else
      config_workspace "$cfg_workspace"
    fi
    exit 0
  fi

  # start [--open] — everything: runtime, agents, every configured workspace
  if [[ $# -ge 1 && "$1" == "start" ]]; then
    [[ $# -le 2 ]] || die "start takes at most --open"
    [[ "${2:-}" == "" || "${2:-}" == "--open" ]] || die "start takes at most --open"
    local start_open=0
    [[ "${2:-}" == "--open" ]] && start_open=1
    start_all "$start_open"
    exit 0
  fi

  # up <workspace> [--open]
  if [[ $# -ge 2 && "$1" == "up" ]]; then
    local up_open=0
    [[ "${3:-}" == "--open" ]] && up_open=1
    up_workspace "$2" "$up_open"
    exit 0
  fi

  # agents <subcommand> [args...]
  if [[ $# -ge 1 && "$1" == "agents" ]]; then
    local agents_sub="${2:-up}"
    if [[ $# -ge 2 ]]; then
      shift 2
    else
      shift 1
    fi
    agents_compose "$agents_sub" "$@"
    exit 0
  fi

  # runtime <subcommand> [args...]
  if [[ $# -ge 1 && "$1" == "runtime" ]]; then
    local runtime_sub="${2:-status}"
    if [[ $# -ge 2 ]]; then
      shift 2
    else
      shift 1
    fi
    runtime_command "$runtime_sub" "$@"
    exit 0
  fi

  [[ $# -ge 2 ]] || { usage; exit 2; }

  local scope="$1"
  [[ "$scope" == "wiki" ]] || die "unknown scope: $scope (expected: wiki, agents, runtime, up, config, or list)"
  shift
  [[ $# -ge 2 ]] || die "wiki requires a workspace and a command"

  local workspace="$1"
  local command="$2"
  shift 2

  case "$command" in
    init)
      run_wiki "$workspace" init "$@"
      ;;
    up)
      start_workspace_services "$workspace"
      local serve_port production_port
      serve_port="$(workspace_value "$workspace" WIKI_SERVE_PORT 3100)"
      production_port="$(workspace_value "$workspace" PRODUCTION_MCP_PORT 3102)"
      printf 'Workspace UI: http://localhost:%s\n' "$serve_port"
      printf 'Chat MCP:     http://localhost:%s/chat\n' "$serve_port"
      printf 'Production:   http://localhost:%s/mcp/\n' "$production_port"
      printf 'Runtime:      %s\n' "$(runtime_health_check && printf 'healthy at %s' "$(runtime_health_url)" || printf 'start with: wiki-workspace runtime up')"
      ;;
    down)
      compose_for_workspace "$workspace" down
      ;;
    refresh)
      refresh_running_services "No running workspace containers to refresh: $workspace" "Refreshed running workspace containers: $workspace (%s)" compose_for_workspace "$workspace"
      ;;
    logs)
      local log_args=()
      read_lines_into_array log_args logs_args "$@"
      compose_for_workspace "$workspace" logs ${log_args[@]+"${log_args[@]}"} serve mcp-http production-mcp
      ;;
    serve)
      local open_browser=0
      if [[ $# -eq 1 && "$1" == "--open" ]]; then
        open_browser=1
      elif [[ $# -ne 0 ]]; then
        die "serve accepts only --open as optional flag; port is configured in the workspace .env"
      fi

      ensure_runtime_up
      printf 'Starting mcp-http...\n'
      compose_for_workspace "$workspace" up -d mcp-http
      printf 'Starting production-mcp...\n'
      compose_for_workspace "$workspace" up -d production-mcp
      local serve_port production_port
      serve_port="$(workspace_value "$workspace" WIKI_SERVE_PORT 3100)"
      production_port="$(workspace_value "$workspace" PRODUCTION_MCP_PORT 3102)"
      printf 'Workspace UI: http://localhost:%s\n' "$serve_port"
      printf 'Chat MCP:     http://localhost:%s/chat\n' "$serve_port"
      printf 'Production:   http://localhost:%s/mcp/\n' "$production_port"
      printf 'Runtime:      %s\n' "$(runtime_health_check && printf 'healthy at %s' "$(runtime_health_url)" || printf 'start with: wiki-workspace runtime up')"
      printf 'Note: compose logs may show http://localhost:3000, which is the container port.\n'
      if [[ $open_browser -eq 1 ]]; then
        wait_and_open "http://localhost:${serve_port}" &
      fi

      compose_for_workspace "$workspace" up serve
      ;;
    reset)
      reset_workspace "$workspace" "$@"
      ;;
    doctor|ingest|build|export)
      run_wiki "$workspace" "$command" "$@"
      ;;
    run)
      [[ $# -gt 0 ]] || die "run requires wiki CLI args"
      run_wiki "$workspace" "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
